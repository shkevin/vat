# Production environment template for VAT
# Copy to .env.production and fill in values before: docker compose -f docker-compose.production.yml up -d

# Database (used by compose; override POSTGRES_* in shell or .env)
POSTGRES_USER=vat
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=vat

# Required for production
VAT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
VAT_ENV=production

# URLs (adjust for your domain; CORS must include frontend origin)
VAT_PUBLIC_URL=https://vat.example.com
VAT_FRONTEND_URL=https://vat.example.com
VAT_CORS_ORIGINS=https://vat.example.com

# Aikido (optional — for sync)
# VAT_AIKIDO_CLIENT_ID=
# VAT_AIKIDO_CLIENT_SECRET=
# VAT_AIKIDO_REGION=eu
# VAT_AIKIDO_WEBHOOK_SECRET=
# VAT_AIKIDO_EXPORT_EXCEL_DIR=/app/data/exports

# Linear (optional — for tracker)
# VAT_LINEAR_API_KEY=
# VAT_LINEAR_TEAM_ID=
# VAT_LINEAR_WEBHOOK_SECRET=

# Google OAuth (optional — for tenants with auth_method=google)
# VAT_GOOGLE_CLIENT_ID=
# VAT_GOOGLE_CLIENT_SECRET=

# Security (recommended for production)
VAT_ALLOW_DEV_HEADERS=false
VAT_REQUIRE_INGEST_AUTH=true
# VAT_INGEST_API_KEY=optional-global-ingest-key
