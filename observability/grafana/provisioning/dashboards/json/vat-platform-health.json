{
  "id": null,
  "uid": "vat-platform-health",
  "title": "VAT Platform Health",
  "tags": ["vat", "platform", "health"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scrape Targets Up",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(up{job=~\"vat-.*|prometheus\"})", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scrape Targets Down",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum((up{job=~\"vat-.*|prometheus\"} == 0))", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Target Availability by Job",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max by (job) (up{job=~\"vat-.*|prometheus\"})", "legendFormat": "{{job}}", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Prometheus Scrape Duration by Job (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, scrape_duration_seconds{job=~\"vat-.*|prometheus\"}[15m])",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Prometheus Scrape Samples Post-Metric-Relabeling",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "scrape_samples_post_metric_relabeling{job=~\"vat-.*|prometheus\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Backend Errors (Loki)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{container=~\".*backend.*\"} |= \"ERROR\" or {container=~\".*backend.*\"} |= \"Traceback\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ]
}

