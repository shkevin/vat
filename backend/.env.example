# VAT Backend Configuration
# Copy to .env and fill in values

VAT_DATABASE_URL=postgresql+asyncpg://vat:vat@localhost:5432/vat

# Aikido API (bootstrap: GET /issues/export)
# Create OAuth app in Aikido Settings → API / Integrations
VAT_AIKIDO_CLIENT_ID=
VAT_AIKIDO_CLIENT_SECRET=
VAT_AIKIDO_REGION=eu  # eu | us | me
# Export sync data to Excel for validation (data science / leadership reporting)
# When set, each sync writes aikido_sync_YYYY-MM-DD_HHMMSS.xlsx to this directory
VAT_AIKIDO_EXPORT_EXCEL_DIR=  # e.g. ./data/exports
# Per-container SBOM (GET /containers/{id}/licenses/export) during dashboard sync — digest backfill for merge
# VAT_AIKIDO_CONTAINER_SBOM_SYNC=false  # set to disable
# VAT_AIKIDO_CONTAINER_SBOM_MAX_CONTAINERS=50  # optional cap (0 = no cap)
# If licenses/export is empty, use POST /containers/sbom/generate instead (bulk batches):
# VAT_AIKIDO_CONTAINER_SBOM_BULK_GENERATE=true
# VAT_AIKIDO_CONTAINER_SBOM_BULK_BATCH_SIZE=20

# Webhook secrets (HMAC validation)
VAT_AIKIDO_WEBHOOK_SECRET=
VAT_LINEAR_WEBHOOK_SECRET=

# Linear API (tracker)
VAT_LINEAR_API_KEY=
VAT_LINEAR_TEAM_ID=  # Required for issue creation (e.g. from Linear team settings)
# API polling — defaults to true when no webhook; false when webhook configured
# VAT_LINEAR_POLL_ENABLED=true  # optional: override (default true without webhook, false with webhook)
VAT_LINEAR_POLL_INTERVAL_MIN=5
VAT_LINEAR_POLL_MAX_ISSUES=100

# Tracker batch updates (generic — Linear, Jira, etc.)
VAT_TRACKER_UPDATE_BATCH_SIZE=15  # max updates per batch request
VAT_TRACKER_BATCH_DELAY_MS=100    # delay between batches (avoids rate limits)

# Auth
VAT_SECRET_KEY=change-me-in-production  # REQUIRED in production (VAT_ENV=production)
VAT_ENV=development  # development | production — production fails startup if secret_key is default
VAT_JWT_EXPIRE_HOURS=24

# Security
VAT_CORS_ORIGINS=http://localhost:3000  # Comma-separated for production (e.g. https://vat.example.com)
VAT_ALLOW_DEV_HEADERS=false  # true: allow X-VAT-User for local dev only
VAT_REQUIRE_INGEST_AUTH=false  # true: require API key for ingest endpoints (production)

# Correlation — cross-source linking after ingest (see docs/correlation-linking-architecture.md)
# VAT_CORRELATION_LINKING_ENABLED=false  # disable automatic linking
# When true, append image digest to SCA/license correlation keys (stricter per-deployment binding)
# VAT_CORRELATION_INCLUDE_DIGEST=true

# Celery (sync worker) — Valkey or Redis (redis:// protocol)
VAT_CELERY_BROKER_URL=redis://localhost:6379/0
