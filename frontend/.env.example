# VAT App Config (server-side env — no NEXT_PUBLIC prefix)
# Copy to .env and override as needed

# Banner
APP_COMPANY_NAME=VAT
APP_NAME=VAT
APP_LOGO=/vat-logo-dark.svg
# Classification banner: leave unset for no banner (local dev); set for DoD deployments
# CLASSIFICATION=UNCLASSIFIED
SEARCH_PLACEHOLDER="Find by CVE, component, team…"
SHOW_THEME_TOGGLE=false
ENV_LABEL=

# Footer (classification bar at bottom). Leave unset when CLASSIFICATION is unset.
# FOOTER_CLASSIFICATION=UNCLASSIFIED
# FOOTER_SUFFIX=" - NO CUI (IL-2)"

# Report branding (client-side — NEXT_PUBLIC prefix required)
# Override logo, company name, etc. for the default report theme. Leave unset for generic reports.
# NEXT_PUBLIC_REPORT_LOGO_URL=https://example.com/logo.svg
# NEXT_PUBLIC_REPORT_COMPANY_NAME=My Company
# NEXT_PUBLIC_REPORT_TAGLINE=Your tagline here
# NEXT_PUBLIC_REPORT_WEBSITE_URL=https://example.com
